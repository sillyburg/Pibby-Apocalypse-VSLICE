import funkin.play.event.SongEvent;
import funkin.play.PlayState;
import flixel.FlxG;

import funkin.play.character.CharacterType;

class JakeFocusEvent extends SongEvent
{
    function new()
    {
        super('JakeOrGF');
    }

    override function getTitle()
    {
        return "Focus on GF or Jake";
    }

    override function handleEvent(params:Dynamic)
    {
        if (PlayState.instance == null) return;

        switch (params.value.focusTo)
        {
            case 1:
                var followPoint = PlayState.instance.currentStage.getGirlfriend().cameraFocusPoint;
                PlayState.instance.cameraFollowPoint.setPosition(followPoint.x, followPoint.cameraFocusPoint.y);
            case 2:
                var followPoint = PlayState.instance.currentStage.getCharacter('jake').cameraFocusPoint;
                PlayState.instance.cameraFollowPoint.setPosition(followPoint.x, followPoint.y);
        }
    }

    override function getEventSchema()
    {
        return [
            {
                name: "focusTo",
                title: "Focus to",
                defaultValue: "Girlfriend",
                type: "enum",
                keys: [
                    'Girlfriend' => 1,
                    'Jake' => 2
                ]
            }
        ];
    }
}