import funkin.play.event.SongEvent;
import funkin.play.PlayState;

import funkin.modding.module.ModuleHandler;

import funkin.util.ReflectUtil;

import funkin.Conductor;

import flixel.tweens.FlxEase;

class CinematicsEvent extends SongEvent
{
    function new()
    {
        super('CinematicsEvent');
    }

    override function getTitle()
    {
        return "Cinematics";
    }

    override function handleEvent(params:Dynamic)
    {   
        if (PlayState.instance == null) return;

        trace('Distance: ' + params.value.distance);
        trace('Speed: ' + params.value.speed);
        trace('Ease: ' + params.value.ease);
        ModuleHandler.getModule('CinematicsModule').scriptCall('doCinematics', [
            params.value.distance,
            (Conductor.instance.stepLengthMs * params.value.speed) / 1000,
            ReflectUtil.field(FlxEase, params.value.ease)
        ]);
    }

    override function getEventSchema()
    {
        return [
            {
                name: "distance",
                title: "Distance",
                defaultValue: "0",
                type: "float"
            },
            {
                name: "speed",
                title: "Speed",
                defaultValue: "1",
                step: 0.25,
                type: "float",
                units: "steps"
            },
            {
                name: "ease",
                title: "Ease",
                defaultValue: "",
                type: "string"
            }
        ];
    }
}