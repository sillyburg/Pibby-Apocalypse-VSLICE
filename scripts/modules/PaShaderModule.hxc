import funkin.play.PlayState;
import funkin.play.components.HealthIcon;

import funkin.Preferences;

import funkin.save.Save;

import flixel.math.FlxMath;

import openfl.filters.ShaderFilter;

import funkin.modding.module.Module;

import funkin.modding.base.ScriptedFlxRuntimeShader;

import flixel.addons.display.FlxRuntimeShader;

import flixel.FlxG;

class PAShaderModule extends Module
{

    /*
    module for stuff like:
    - the zoom aberration
    - the opponent sing glitch
    - health drain
    - and the icon glitch
    */
    
    var zoomShad:ScriptedFlxRuntimeShader;
    var pibbyFNF:ScriptedFlxRuntimeShader;
    var iconDistort:ScriptedFlxRuntimeShader;

    var shadIntensity:Float;
    var glitchIntensity:Float;

    var playerIcons:Array<HealthIcon> = [];
    var cpuIcons:Array<HealthIcon> = [];

    var initialized:Bool = false;

    var singMult:Float;

    public function new()
    {
        super('paShaderModule', 1);
    }

    function onSongRetry(e:Dynamic)
    {
        super.onSongRetry(e);

        initialized = false;

        cpuIcons = [];
        playerIcons = [];
    }

    function removeShaders()
    {
        if (!Save.instance.modOptions.get('PibbyApocalypse').get('glitchEffects')) return;

        FlxG.camera.filters = PlayState.instance.camHUD.filters = [];

        initialized = false;

        pibbyFNF = zoomShad = null;
    }

    function createShaders()
    {
        if (!Save.instance.modOptions.get('PibbyApocalypse').get('glitchEffects')) return;

        if (PlayState.instance == null) return;

        singMult = Save.instance.modOptions.get("PibbyApocalypse").get('singGlitchMult');

        if (!playerIcons.contains(PlayState.instance.iconP1))
            playerIcons.push(PlayState.instance.iconP1);

        if (!cpuIcons.contains(PlayState.instance.iconP2))
            cpuIcons.push(PlayState.instance.iconP2);

        zoomShad = ScriptedFlxRuntimeShader.init("PA_AberrationShader");
        iconDistort = ScriptedFlxRuntimeShader.init("PA_DistortShader");
        pibbyFNF = ScriptedFlxRuntimeShader.init("PA_ChromaticShader");

        // use the same array for the filters
        FlxG.camera.filters =
        PlayState.instance.camHUD.filters = [new ShaderFilter(zoomShad), new ShaderFilter(pibbyFNF)];

        initialized = true;
    }

    function onBeatHit(e:SongEventScriptEvent)
    {
        if (PlayState.instance == null) return;
        if (!initialized) return;

        super.onBeatHit(e);

        if (!PlayState.instance.startingSong && e.beat % PlayState.instance.cameraZoomRate == 0 && Preferences.zoomCamera)
            shadIntensity = 0.08;
    }

    function onSongEvent(e:Dynamic)
    {
        if (PlayState.instance == null) return;
        if (!initialized) return;

        super.onSongEvent(e);

        if (e.eventData.eventKind == 'AddZoomEvent')
            shadIntensity = 0.08;
    }

    override function onNoteHit(event:Dynamic)
    {
        if (PlayState.instance == null) return;
        if (!initialized) return;

        super.onNoteHit(event);

        if (!event.note.noteData.getMustHitNote() && FlxG.random.bool(50) && event.note.noteData.kind != 'pibbyInvisibleSing')
            glitchIntensity = FlxG.random.float(0.2, 0.7) * singMult;
    }

    var time:Float = 0;

    function onUpdate(e:Dynamic)
    {
        if (PlayState.instance == null) return;
        if (!initialized) return;

        super.onUpdate(e);

        if (PlayState.instance.isGamePaused) return;
            
        time += e.elapsed;

        shadIntensity = FlxMath.lerp(shadIntensity, 0, FlxMath.bound(e.elapsed * 6, 0, 1));
        glitchIntensity = FlxMath.lerp(glitchIntensity, 0, FlxMath.bound(e.elapsed * 7, 0, 1));

        zoomShad.aberration = shadIntensity;
        pibbyFNF.multiplier = glitchIntensity;
        pibbyFNF.time = time;
    }

    function onDestroy(e:Dynamic)
    {
        if (PlayState.instance == null) return;
        if (!initialized) return;

        super.onDestroy(e);

        initialized = false;

        FlxG.camera.filters = [];
    }

    function onStepHit(e:Dynamic)
    {
        super.onStepHit(e);

        if (PlayState.instance == null) return;

        if (!initialized) return;

        for (iconsArray in [cpuIcons, playerIcons])
            for (icon in iconsArray)
                if (icon != null)
                    (icon.getCurrentAnimation() == "losing" ? _iconGlitch : removeIconGlitch)(icon);

        /*
        if (PlayState.instance.health <= )
        {
            for (i in playerIcons)
                if (i != null)
                {
                    setIconGlitch(i);
                    updateIconGlitch(i);
                }
        } else for (i in playerIcons)
            if (i != null)
                removeIconGlitch(i);

        if (PlayState.instance.health >= 1.6)
        {
            for (i in cpuIcons)
            {
                if (i != null)
                {
                    setIconGlitch(i);
                    updateIconGlitch(i);
                }
            }
        } else for (i in cpuIcons)
            if (i != null)
                removeIconGlitch(i);
            */
    }

    function _iconGlitch(icon:HealthIcon)
    {
        setIconGlitch(icon);
        updateIconGlitch(icon);
    }

    function onGameOver(e:Dynamic)
    {
        super.onGameOver(e);

        FlxG.camera.filters = [];
    }

    function setIconGlitch(icon:HealthIcon)
    {
        if (icon.shader != null) return;

        icon.shader = new FlxRuntimeShader(Assets.getText(Paths.frag('distort')));
    }

    function removeIconGlitch(icon:HealthIcon)
    {
        if (icon.shader == null) return;

        icon.shader = null;
    }

    function updateIconGlitch(icon:HealthIcon)
    {
        if (iconDistort == null) return;

        iconDistort.intensity = FlxG.random.float(4, 6);
        iconDistort.negativity = 0;
    }

    function pa_addPlayerIcon(icon:HealthIcon)
    {
        playerIcons.push(icon);
    }

    function pa_addCpuIcon(icon:HealthIcon)
    {
        cpuIcons.push(icon);
    }
}