import flixel.FlxCamera;
import flixel.FlxG;
import flixel.FlxSprite;

import funkin.play.PlayState;

import funkin.util.ReflectUtil;

import funkin.graphics.FunkinSprite;

import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;

import funkin.modding.module.Module;

import funkin.Conductor;

class CinematicsModule extends Module
{
    var topBar:FlxSprite;
    var bottomBar:FlxSprite;

    var topY:Float;
    var bottomY:Float;

    var barCamera:FlxCamera;

    var topBarTween:FlxTween = null;
    var bottomBarTween:FlxTween = null;

    var doTransition:Bool = true;

    function new()
    {
        super("CinematicsModule");
    }

    function onSongLoaded(e:Dynamic)
    {
        super.onSongLoaded(e);

        if (PlayState.instance == null) return;

        if (barCamera == null)
        {
            barCamera = new FlxCamera();

            FlxG.cameras.insert(barCamera, FlxG.cameras.list.indexOf(PlayState.instance.camHUD), false);

            barCamera.bgColor = 0;

            barCamera.width *= 1.5;
            barCamera.height *= 1.5;

            barCamera.x -= 50;
        }

        if (topBar == null)
        {
            topBar = new FunkinSprite(-50, 0).makeSolidColor(FlxG.camera.width * 1.2, FlxG.camera.height, 0xFF000000);

            topBar.cameras = [barCamera];
            topBar.screenCenter(0x01);
            topBar.y = -FlxG.height;

            topY = topBar.y;

            PlayState.instance.add(topBar);
        }

        if (bottomBar == null)
        {
            bottomBar = new FunkinSprite(-50, 0).makeSolidColor(FlxG.camera.width * 1.2, FlxG.camera.height, 0xFF000000);

            bottomBar.cameras = [barCamera];
            bottomBar.screenCenter(0x01);
            bottomBar.y = FlxG.height;

            bottomY = bottomBar.y;

            PlayState.instance.add(bottomBar);
        }
    }

    function onSongStart(e:Dynamic)
    {
        super.onSongStart(e);
    }

    function doCinematics(distance:Float, speed:Float, ease:FlxEase)
    {
        trace("cinematics");

        if (topBar == null) return;
        if (bottomBar == null) return;

        if (topBarTween != null) topBarTween.cancel();
        if (bottomBarTween != null) bottomBarTween.cancel();

        if (speed > 0) {
            topBarTween = FlxTween.tween(topBar, {y: topY + distance}, speed, {ease: ease});
            bottomBarTween = FlxTween.tween(bottomBar, {y: bottomY - distance}, speed, {ease: ease});
        } else {
            topBar.y = topY + distance;
            bottomBar.y = bottomY - distance;
        }
    }

    function onSongRetry(e:Dynamic)
    {
        super.onSongRetry(e);

        if (doTransition)
            doCinematics(0, 0.5, FlxEase.expoIn);    
        else
        {
            topBar.y = topY;
            bottomBar.y = bottomY;
        }
    }

    function onDestroy(e:Dynamic)
    {
        super.onDestroy(e);

        topBar?.destroy();
        bottomBar?.destroy();
        barCamera?.destroy();

        if (barCamera != null)
            barCamera = null;

        if (topBar != null)
            topBar = null;

        if (bottomBar != null)
            bottomBar = null;
    }

    function onPause(e:Dynamic)
    {
        if (e.cancelled) return;

        for (i in [topBarTween, bottomBarTween])
            if (i != null)
                i.active = false;

        super.onPause(e);
    }

    function onResume(e:Dynamic)
    {
        super.onResume(e);

        for (i in [topBarTween, bottomBarTween])
            if (i != null)
                i.active = true;
    }
}