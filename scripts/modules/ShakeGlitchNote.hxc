import funkin.modding.module.Module;

import flixel.addons.display.FlxRuntimeShader;

import funkin.play.PlayState;

import flixel.FlxG;

import flixel.tweens.FlxEase;
import flixel.tweens.FlxTween;

class ShakeGlitchNote extends Module
{
    var game:PlayState;

    var originalNotePos:Array<Float, Float> = [];

    final pa_resetInterval:Float = 3;

    var _resetTime:Float = 0.0;

    var _glitched:Bool = false;
    var _tweens:Array<FlxTween> = [];

    public function new() {
        super('ShakeGlitchNote');
    }

    function setNotePos(){
        originalNotePos = [];
        var pos = 0;
        for (i in PlayState.instance.opponentStrumline.strumlineNotes.members){
            originalNotePos.insert(pos, [i.x, i.y]);
            pos += 1;
        }

        for (i in PlayState.instance.playerStrumline.strumlineNotes.members){
            originalNotePos.insert(pos, [i.x, i.y]);
            pos += 1;
        }    
    }

    function onUpdate(e)
    {
        if (PlayState.instance == null) return;

        var _paused:Bool = !PlayState.instance.isGamePaused; // caching cuz it has a get

        for (twn in _tweens)
            if (twn != null && twn.active != _paused)
                twn.active = _paused;

        if (PlayState.instance.isGamePaused || !_glitched) return;

        function _twn(obj, id:Int)
            _tweens.push(FlxTween.tween(obj, {x: originalNotePos[id][0], y: originalNotePos[id][1]}, 1, {ease: FlxEase.sineInOut, onComplete: (twn:FlxTween) -> _tweens.remove(twn)}));

        for (b => i in PlayState.instance.opponentStrumline.strumlineNotes.members)
            _twn(i, b);

        for (b => i in PlayState.instance.playerStrumline.strumlineNotes.members)
            _twn(i, b + 4);

        _resetTime += e.elapsed;

        if (_resetTime >= pa_resetInterval)
        {
            _resetTime = 0;

            _glitched = false;
        }
    }

    function glitchStrums(){
        var pos = 0;
        _resetTime = 0;

        for (i in PlayState.instance.opponentStrumline.strumlineNotes.members){
            i.x = originalNotePos[pos][0] + FlxG.random.int(-8, 8);
            i.y = originalNotePos[pos][1] + FlxG.random.int(-8, 8);
            pos += 1;
        }

        for (i in PlayState.instance.playerStrumline.strumlineNotes.members){
            i.x = originalNotePos[(pos)][0] + FlxG.random.int(-8, 8);
            i.y = originalNotePos[(pos)][1] + FlxG.random.int(-8, 8);
            pos += 1;
        }

        _glitched = true;
    }
}